{
  "name": "content-quality-auditor",
  "version": "1.0.0",
  "private": true,
  "description": "AI content quality auditor on Vercel: scores articles with Groq (accuracy, readability, keywords, missing sections, plagiarism), saves every audit, sends low scores to a review queue and validates against your own scores.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-server.mjs --api-only",
    "build": "vite build",
    "preview": "node scripts/dev-server.mjs",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "generate": "node scripts/build-engine.mjs && node scripts/build-mock.mjs",
    "check": "npm test && npm run generate && git diff --exit-code -- api/_engine.js api/_mock-data.js && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@vercel/blob": "2.8.1",
    "@vercel/functions": "3.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "6.4.4"
  }
}
