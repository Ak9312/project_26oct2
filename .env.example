# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Never commit real values.

# Required: from console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=

# Recommended: fact-checking claims and finding missing sections (serpapi.com)
SERPAPI_KEY=

# Recommended: plagiarism check (copyscape.com Premium API)
COPYSCAPE_USERNAME=
COPYSCAPE_API_KEY=

# Optional. If set, people must type this password to use the app.
# If left empty, anyone with the link can run audits (and spend your API credits).
APP_PASSWORD=

# Added automatically when the Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=

# Optional tuning (defaults shown)
# PASS_MARK=70
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# MAX_PROMPT_CHARS=14000
# LLM_PAUSE_SECONDS=15
# COMPETITOR_PAGES=6

# 1 = built-in sample data, calls no outside service
MOCK_MODE=
