# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Password people type to use the app.
APP_PASSWORD=

# Your n8n address, without a trailing slash, e.g. https://yourname.app.n8n.cloud
N8N_BASE_URL=

# Long random string. Must equal the value of the n8n "Content Auditor webhook secret"
# Header Auth credential (header name: x-auditor-secret). Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# 1 = serve built-in sample data instead of calling n8n (for previews only).
MOCK_MODE=
